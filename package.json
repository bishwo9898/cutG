{
  "name": "cutg",
  "version": "0.1.0",
  "private": true,
  "description": "Technical foundation for cutG, a barber operations and client booking platform.",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web,ai-api,ai-worker -c blue,green,magenta,cyan \"pnpm dev:api\" \"pnpm dev:web\" \"pnpm dev:ai\" \"pnpm dev:ai-worker\"",
    "dev:api": "pnpm --filter @barber-saas/api dev",
    "dev:web": "pnpm --filter @barber-saas/web dev",
    "dev:ai": "services/ai/.venv/bin/uvicorn app.main:app --app-dir services/ai --reload --port 8000",
    "dev:ai-worker": "cd services/ai && sh scripts/run_worker.sh",
    "build": "pnpm -r build",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tsc": "pnpm typecheck",
    "typecheck": "pnpm --filter @barber-saas/shared-types build && pnpm --filter @barber-saas/shared-utils build && pnpm -r typecheck",
    "test": "pnpm test:api && pnpm --filter @barber-saas/web test && pnpm --filter @barber-saas/mobile test && pnpm test:ai",
    "test:ai": "services/ai/.venv/bin/python -m pytest services/ai/tests",
    "verify:hair-studio": "node scripts/verify-hair-studio.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:api:local": "docker compose up -d postgres-test && pnpm test:api",
    "db:migrate": "pnpm --filter @barber-saas/api db:migrate",
    "db:rollback": "pnpm --filter @barber-saas/api db:rollback",
    "db:seed": "pnpm --filter @barber-saas/api db:seed",
    "db:connect": "psql ${DATABASE_URL:-postgresql://barber_user:barber_password@localhost:55433/barber_saas}"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
