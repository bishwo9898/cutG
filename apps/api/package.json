{
  "name": "@barber-saas/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "knex --knexfile src/knexfile.ts migrate:latest",
    "db:migrate:compiled": "knex --knexfile dist/knexfile.js migrate:latest",
    "db:rollback": "knex --knexfile src/knexfile.ts migrate:rollback",
    "db:seed": "knex --knexfile src/knexfile.ts seed:run",
    "db:seed:compiled": "knex --knexfile dist/knexfile.js seed:run",
    "storage:cloudinary:backfill": "tsx src/scripts/backfillCloudinary.ts",
    "storage:cloudinary:verify": "tsx src/scripts/verifyCloudinary.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/s3-request-presigner": "^3.1089.0",
    "@barber-saas/shared-types": "workspace:*",
    "@barber-saas/shared-utils": "workspace:*",
    "@clerk/backend": "^3.16.12",
    "@clerk/express": "^2.1.63",
    "@faker-js/faker": "^8.4.1",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "knex": "^3.1.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
