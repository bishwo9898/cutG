# API-specific copy for local app execution. Root .env.example contains the full platform list.
NODE_ENV=development
LOG_LEVEL=debug
PORT=4000
HOST=localhost
DATABASE_URL=postgresql://barber_user:barber_password@localhost:5432/barber_saas
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
WEB_APP_URL=http://localhost:3000
EMAIL_PROVIDER=log
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
# Clerk (https://dashboard.clerk.com -> API Keys). Web and mobile must use the same instance.
CLERK_SECRET_KEY=sk_test_placeholder_change_me
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_change_me
