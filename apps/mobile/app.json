{
  "expo": {
    "name": "cutG",
    "slug": "cutg",
    "scheme": "cutg",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cutg.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.cutg.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F3EC"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow cutG to use your precise location to find nearby barbers, set service addresses, and guide active journeys.",
          "locationAlwaysAndWhenInUsePermission": "Allow cutG to share your journey with the client, including while the app is in the background.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow cutG to take a private hairstyle preview photo.",
          "microphonePermission": false,
          "photosPermission": "Allow cutG to select a private hairstyle preview photo."
        }
      ],
      "expo-notifications",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F7F3EC"
        }
      ],
      "expo-status-bar",
      "expo-dev-client",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.cutg.mobile",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": { "typedRoutes": false }
  }
}
