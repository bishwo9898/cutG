# Optional override. When omitted, Expo development builds derive the Metro host automatically.
# Physical devices must use a LAN-reachable API address, never localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# Production example: EXPO_PUBLIC_API_URL=https://cutg-api.onrender.com
# Clerk (https://dashboard.clerk.com -> API Keys). Must be the same Clerk application used by
# the web app and API.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
# Set only for a personal-team Xcode build; push alerts and Apple Pay require membership.
CUTG_FREE_IOS_BUILD=false
EXPO_PUBLIC_ENABLE_HAIR_STUDIO=false
EXPO_PUBLIC_ENABLE_EARNINGS=false
EXPO_PUBLIC_ENABLE_SUBSCRIPTIONS=false
# Prefills the seeded test accounts on the sign-in screen. Local development only.
EXPO_PUBLIC_FIELD_TEST_MODE=false
