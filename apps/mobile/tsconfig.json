{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "@/*": ["src/*"],
      "@barber-saas/api-client": ["../../packages/api-client/src"],
      "@barber-saas/shared-types": ["../../packages/shared-types/src"],
      "@barber-saas/shared-utils": ["../../packages/shared-utils/src"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
