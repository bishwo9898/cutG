# Server-only URL for the separately deployed cutG API. Do not prefix this with NEXT_PUBLIC_.
API_BASE_URL=http://localhost:4000

# Values with NEXT_PUBLIC_ are embedded in browser bundles and must never contain secrets.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MEDIAPIPE_FACE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
